#!/bin/sh
# shellcheck disable=SC2034 # heartbeat_seconds is read by `run` (GL3)
# gate-lock: host-wide gate lock (on-disk format 1). Built so far: configuration,
# the pool and the .format marker, `workers`, the slot subcommands acquire,
# heartbeat, verify, release and status, and the janitor `clean`. `run` is not
# built yet.
set -u
LC_ALL=C
export LC_ALL
# Everything this tool creates is owner-only unless a mode is set explicitly.
umask 077

# Resolve $0 to an absolute, physical path once (no realpath): follow symlinks
# (npm's .bin links to this file), then canonicalise the directory with
# `cd ... && pwd -P`. readlink and dirname exist on GNU, BSD/macOS and busybox.
self=$0
case $self in
*/*) ;;
*) self=$(command -v -- "$self") || self=$0 ;;
esac
hops=0
while [ -h "$self" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    echo "gate-lock: too many levels of symbolic links" >&2
    exit 2
  fi
  target=$(readlink -- "$self") || break
  case $target in
  /*) self=$target ;;
  *) self=$(dirname -- "$self")/$target ;;
  esac
done
self_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P) || {
  echo "gate-lock: cannot resolve the script directory" >&2
  exit 2
}

if [ "$#" -eq 1 ]; then
  case $1 in
  --format)
    echo 1
    exit 0
    ;;
  --version)
    version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p' "$self_dir/../package.json" | head -n 1) || version=
    if [ -z "$version" ]; then
      echo "gate-lock: cannot read the package version" >&2
      exit 2
    fi
    echo "$version"
    exit 0
    ;;
  esac
fi

# ---------------------------------------------------------------------------
# Helpers. Messages go through printf: dash's echo would expand backslashes in
# a value an operator typed.
# ---------------------------------------------------------------------------

die() {
  printf 'gate-lock: %s\n' "$*" >&2
  exit 2
}

# is_digits VALUE: non-empty and nothing but ASCII digits (LC_ALL=C, so a
# non-ASCII digit is not one). A newline inside VALUE is not a digit either.
is_digits() {
  case $1 in
  '' | *[!0-9]*) return 1 ;;
  esac
  return 0
}

# strip_zeros VALUE: leading zeros are a spelling; keep at least one digit.
# Sets $norm.
strip_zeros() {
  norm=$1
  while :; do
    case $norm in
    0?*) norm=${norm#0} ;;
    *) break ;;
    esac
  done
}

# reduce PATH: drop trailing slashes (F2). Sets $reduced; "/" reduces to "".
reduce() {
  reduced=$1
  while :; do
    case $reduced in
    */) reduced=${reduced%/} ;;
    *) break ;;
    esac
  done
}

# Directory attributes without stat or realpath, neither of which is portable.
# `find <p> -prune` tests the path itself (it never follows a symlink named on
# the command line, and never descends); -user takes a numeric id; -perm takes
# an octal mode. Unlike parsing `ls -ld`, the answer does not depend on the
# locale, on user-name mapping, or on the ACL and attribute marker some
# systems append to the mode string.
owned_by() { [ -n "$(find "$1" -prune -user "$2" -print 2>/dev/null)" ]; }
not_group_other_writable() {
  [ -n "$(find "$1" -prune ! -perm -020 ! -perm -002 -print 2>/dev/null)" ]
}
mode_is_0700() { [ -n "$(find "$1" -prune -perm 0700 -print 2>/dev/null)" ]; }

# tmp_trusted DIR (D1, D16): a temp directory is only trusted when it is ours or
# sticky, which is what makes a file in it safe against a plant: in a directory
# only we can write, or in a sticky one, nobody else can replace what we put
# there. Somebody else's plain directory could be rigged, so it is not used.
# The expected uid is the real one, and GATE_LOCK_TEST_TMP_UID makes the one
# ownership claim foreign on its own so this branch is testable; empty is inert.
tmp_trusted() {
  tt_uid=$real_uid
  seam GATE_LOCK_TEST_TMP_UID
  [ -z "$seam_value" ] || tt_uid=$seam_value
  if ! owned_by "$1" "$tt_uid" &&
    [ -z "$(find "$1" -prune -perm -1000 -print 2>/dev/null)" ]; then
    return 1
  fi
  return 0
}

# tmp_root: the physical temp directory to use when TMPDIR is unset, unusable or
# untrusted. Sets $tmp_phys. TMPDIR is used when it is there and trusted; the
# seam root, else /tmp, is the fallback in every other case. Used by the pool
# resolver (D1) and by the janitor's age reference (D16), so one rule decides
# where a scratch file of ours may live.
tmp_root() {
  tmp_phys=
  case ${TMPDIR:-} in
  /*) tmp_phys=$(CDPATH='' cd -- "$TMPDIR" 2>/dev/null && pwd -P) || tmp_phys= ;;
  esac
  if [ -n "$tmp_phys" ]; then
    if tmp_trusted "$tmp_phys"; then
      [ "$tmp_phys" != / ] || tmp_phys=
      return 0
    fi
    # Not ours and not sticky: not trusted. Silent fallback.
    tmp_phys=
  fi
  seam GATE_LOCK_TEST_TMP_ROOT
  fallback_root=${seam_value:-/tmp}
  tmp_phys=$(CDPATH='' cd -- "$fallback_root" 2>/dev/null && pwd -P) || return 1
  [ "$tmp_phys" != / ] || tmp_phys=
  return 0
}

# ---------------------------------------------------------------------------
# Test-mode gate (D20): the GATE_LOCK_TEST_* seams are honoured only when
# GATE_LOCK_TEST_MODE is exactly 1. Otherwise a set one is named in a one-line
# warning and ignored.
# ---------------------------------------------------------------------------

test_mode=0
if [ "${GATE_LOCK_TEST_MODE:-}" = 1 ]; then
  test_mode=1
else
  ignored=$(env | sed -n 's/^\(GATE_LOCK_TEST_[A-Za-z0-9_]*\)=..*$/\1/p' | tr '\n' ' ')
  ignored=${ignored% }
  if [ -n "$ignored" ]; then
    printf 'gate-lock: warning: ignoring %s (test seams need GATE_LOCK_TEST_MODE=1)\n' "$ignored" >&2
  fi
fi

# seam NAME: the value of a seam variable, empty when it is unset, empty or not
# in test mode. Sets $seam_value.
seam() {
  seam_value=
  if [ "$test_mode" = 1 ]; then
    eval "seam_value=\${$1:-}"
  fi
}

# pause_at SEAM (H1-H8, D20): in test mode, when the seam names a file, create
# it, then wait (whole seconds, L10) for as long as it exists. Defined here,
# before the first window it opens (H1, the marker publication), so every
# subcommand can park.
pause_at() {
  seam "$1"
  [ -n "$seam_value" ] || return 0
  : >"$seam_value" 2>/dev/null
  while [ -e "$seam_value" ]; do
    sleep 1
  done
}

# ---------------------------------------------------------------------------
# Numbers (section 4). A slot count is 1..64; a worker count is at least 1 and
# never compared by a shell when it has many digits.
# ---------------------------------------------------------------------------

# parse_slots NAME VALUE (V3-V5): sets $slots_n.
parse_slots() {
  is_digits "$2" || die "$1 must be a number of slots, got '$2'"
  strip_zeros "$2"
  case $norm in
  ???*) die "$1 must be at most 64 slots: $2" ;;
  esac
  [ "$norm" -ne 0 ] || die "$1 must be at least one slot: $2"
  [ "$norm" -le 64 ] || die "$1 must be at most 64 slots: $2"
  slots_n=$norm
}

# parse_workers NAME VALUE (V7): sets $workers_norm (the spelling without
# leading zeros, for comparing) and $workers_n (clamped, for dividing).
parse_workers() {
  is_digits "$2" || die "$1 must be a number of workers, got '$2'"
  strip_zeros "$2"
  [ "$norm" != 0 ] || die "$1 must be at least one worker: $2"
  workers_norm=$norm
  case $norm in
  ??????????*) workers_n=999999999 ;;
  *) workers_n=$norm ;;
  esac
}

# cap_validate NAME VALUE SLOTVAR (V23): a worker cap is a positive whole
# number. Sets $norm. The text is shared with resolveMaxWorkers in src/index.js.
cap_validate() {
  if is_digits "$2"; then
    strip_zeros "$2"
    [ "$norm" != 0 ] && return 0
  fi
  die "$1 must be a positive whole number, got '$2'; the worker cap is set host-wide, beside $3"
}

# digits_gt A B: A > B, for digit strings without leading zeros, by length and
# then digit by digit, so no shell arithmetic is involved and nothing can wrap.
digits_gt() {
  [ "${#1}" -eq "${#2}" ] || {
    [ "${#1}" -gt "${#2}" ]
    return
  }
  gt_a=$1
  gt_b=$2
  while [ -n "$gt_a" ]; do
    gt_ca=${gt_a%"${gt_a#?}"}
    gt_cb=${gt_b%"${gt_b#?}"}
    if [ "$gt_ca" != "$gt_cb" ]; then
      [ "$gt_ca" -gt "$gt_cb" ]
      return
    fi
    gt_a=${gt_a#?}
    gt_b=${gt_b#?}
  done
  return 1
}

# get_procs (V19): read the processor count at most once. Two sources:
#  - the lock tool (V11 slot derivation, V13 budget) wants the host's online
#    count: `getconf _NPROCESSORS_ONLN`;
#  - `gate-lock workers` (procs_affinity=1) wants what this process may really
#    use, so it tries `nproc` (with OMP_NUM_THREADS and OMP_THREAD_LIMIT unset,
#    which GNU nproc honours) first (GNU and busybox honour CPU affinity and
#    cpusets) and falls back to getconf where nproc is missing or fails.
# Sets $procs_ok (1 when it is a number), $procs_raw, $procs_norm (leading zeros
# stripped, as is) and $procs_n (the same, but nine or more digits clamped so
# that arithmetic cannot wrap; only the lock tool divides by it).
procs_affinity=0
procs_done=0
procs_ok=0
procs_raw=
procs_n=
procs_norm=
get_procs() {
  [ "$procs_done" = 0 ] || return 0
  procs_done=1
  seam GATE_LOCK_TEST_NPROC
  if [ -n "$seam_value" ]; then
    procs_raw=$seam_value
  else
    procs_raw=
    if [ "$procs_affinity" = 1 ]; then
      procs_raw=$(unset OMP_NUM_THREADS OMP_THREAD_LIMIT; nproc 2>/dev/null) || procs_raw=
    fi
    is_digits "$procs_raw" || procs_raw=$(getconf _NPROCESSORS_ONLN 2>/dev/null) || procs_raw=
  fi
  if is_digits "$procs_raw"; then
    strip_zeros "$procs_raw"
    procs_norm=$norm
    case $norm in
    ?????????*) procs_n=999999999 ;;
    *) procs_n=$norm ;;
    esac
    procs_ok=1
  fi
}

# ---------------------------------------------------------------------------
# `gate-lock workers` (V28): the per-run worker cap, by the same rules as
# resolveMaxWorkers (V21-V26). It needs no pool, so it does not resolve the
# pool configuration.
# ---------------------------------------------------------------------------

if [ "${1:-}" = workers ]; then
  [ "$#" -eq 1 ] || {
    echo "gate-lock: usage: gate-lock workers" >&2
    exit 2
  }
  if [ "${GATE_LOCK_WORKERS+set}" = set ]; then
    cap_name=GATE_LOCK_WORKERS
    cap_raw=$GATE_LOCK_WORKERS
    cap_slotvar=GATE_LOCK_SLOTS
  elif [ -n "${GATE_HOST_WORKERS:-}" ]; then
    cap_name=GATE_HOST_WORKERS
    cap_raw=$GATE_HOST_WORKERS
    cap_slotvar=GATE_HOST_SLOTS
  else
    exit 0
  fi
  cap_validate "$cap_name" "$cap_raw" "$cap_slotvar"
  cap_norm=$norm
  procs_affinity=1
  get_procs
  [ "$procs_ok" = 1 ] || die "cannot read the processor count: nproc and getconf _NPROCESSORS_ONLN gave '$procs_raw'"
  # Same rule as resolveMaxWorkers: the real count, no clamp, compared as strings.
  ! digits_gt "$cap_norm" "$procs_norm" ||
    die "$cap_name=$cap_raw is above this host's available parallelism ($procs_norm); a cap above the thread count is not a cap"
  printf '%s\n' "$cap_norm"
  exit 0
fi

# ---------------------------------------------------------------------------
# Configuration (C1, D9): resolved once per invocation, for every other
# subcommand, before the usage check. Order (V16): pool directory, marker,
# stale threshold, heartbeat period, worker agreement, counts, budget,
# disagreement. A refusal is exit 2 and takes no lock.
# ---------------------------------------------------------------------------

real_uid=$(id -u) || die "cannot determine the user id"
leaf_uid=$real_uid
seam GATE_LOCK_TEST_UID
[ -z "$seam_value" ] || leaf_uid=$seam_value
parent_uid=$leaf_uid
seam GATE_LOCK_TEST_PARENT_UID
[ -z "$seam_value" ] || parent_uid=$seam_value
is_digits "$leaf_uid" || die "GATE_LOCK_TEST_UID must be a numeric user id"
is_digits "$parent_uid" || die "GATE_LOCK_TEST_PARENT_UID must be a numeric user id"

# --- Pool resolution (D1) -----------------------------------------------------

if [ -n "${GATE_LOCK_DIR:-}" ]; then
  # F1-F3, judged on the spelling before anything is created (F6).
  case $GATE_LOCK_DIR in
  /*) ;;
  *) die "GATE_LOCK_DIR=$GATE_LOCK_DIR must be an absolute path" ;;
  esac
  reduce "$GATE_LOCK_DIR"
  pool=$reduced
  [ -n "$pool" ] ||
    die "GATE_LOCK_DIR=$GATE_LOCK_DIR is the filesystem root; the pool must be a directory of its own, not the filesystem root"
  case $pool in
  *//* | */./* | */../* | */. | */..)
    die "GATE_LOCK_DIR=$pool must be a plain absolute path (no empty, . or .. components)"
    ;;
  esac
  pool_label="GATE_LOCK_DIR=$pool"
  parent_label="GATE_LOCK_DIR's parent"
  pool_hint=
else
  pool=
  # XDG_RUNTIME_DIR, when it is a plain, absolute, existing 0700 directory of
  # ours with no symlinked component. An unusable one is ignored, never an error.
  xdg=${XDG_RUNTIME_DIR:-}
  if [ -n "$xdg" ]; then
    reduce "$xdg"
    xdg=$reduced
    xdg_ok=1
    case $xdg in
    /?*) ;;
    *) xdg_ok=0 ;;
    esac
    case $xdg in
    *//* | */./* | */../* | */. | */..) xdg_ok=0 ;;
    esac
    if [ "$xdg_ok" = 1 ]; then
      if [ -h "$xdg" ] || [ ! -d "$xdg" ] || ! owned_by "$xdg" "$leaf_uid" || ! mode_is_0700 "$xdg"; then
        xdg_ok=0
      else
        a=$xdg
        while :; do
          a=${a%/*}
          [ -n "$a" ] || break
          if [ -h "$a" ]; then
            xdg_ok=0
            break
          fi
        done
      fi
    fi
    [ "$xdg_ok" = 1 ] && pool=$xdg/gate-lock
  fi
  if [ -z "$pool" ]; then
    # Our own per-uid intermediate under the physical TMPDIR (or /tmp), so the
    # pool's parent is a directory only we can write, never the sticky /tmp.
    if ! tmp_root; then
      die "cannot resolve the temporary directory $fallback_root, the fallback for TMPDIR"
    fi
    [ -n "$tmp_phys" ] ||
      die "the temporary directory for the gate lock would be the filesystem root; name the pool with GATE_LOCK_DIR instead"
    inter=$tmp_phys/gate-lock-$real_uid
    mkdir -m 0700 "$inter" 2>/dev/null
    if [ -h "$inter" ] || [ ! -d "$inter" ] || ! owned_by "$inter" "$leaf_uid" || ! mode_is_0700 "$inter"; then
      die "GATE_LOCK_DIR is unset and the default directory $inter is not a private directory (mode 0700, owned by uid $leaf_uid, not a symlink); if it is owned by another user, set GATE_LOCK_DIR to a directory you own"
    fi
    pool=$inter/pool
  fi
  pool_label="the default pool $pool"
  parent_label="the default pool's parent"
  pool_hint="; set GATE_LOCK_DIR to use another pool"
fi

# --- Directory rules (F4-F8) --------------------------------------------------

parent=${pool%/*}
[ -n "$parent" ] || parent=/
if [ -h "$parent" ] || [ ! -d "$parent" ] || ! owned_by "$parent" "$parent_uid" || ! not_group_other_writable "$parent"; then
  die "$parent_label $parent is not safe to use: it must be a directory, not a symlink, owned by uid $parent_uid and not writable by group or others; no lock was taken (if a symlink is the problem, name the pool by its physical path: cd to the directory and use pwd -P)"
fi
a=$parent
while :; do
  a=${a%/*}
  [ -n "$a" ] || break
  if [ -h "$a" ]; then
    die "$pool_label: $a is a symlink; name the pool by its physical path (cd to the directory and use pwd -P); no lock was taken"
  fi
done

# F7: owner-only, set explicitly so the umask cannot loosen it. Failures,
# including "already exists", are ignored; the judgement below decides.
mkdir -m 0700 "$pool" 2>/dev/null
if [ -h "$pool" ] || [ ! -d "$pool" ] || ! owned_by "$pool" "$leaf_uid" || ! not_group_other_writable "$pool"; then
  die "$pool_label is not safe to use: it must be a directory, not a symlink, owned by uid $leaf_uid, and neither group- nor world-writable; no lock was taken$pool_hint"
fi

# --- The .format marker (F11-F15, D2) -------------------------------------------

marker=$pool/.format
if [ ! -e "$marker" ]; then
  # Temp file, then a hard link: link(2) fails if the name exists, so it never
  # replaces another client's marker (F12). The temp file is named after .format
  # plus our pid; `clean` removes a dead one (D2). noclobber makes the write
  # refuse an existing name.
  marker_tmp=$pool/.format.tmp.$$
  if (
    set -C
    printf '1\n' >"$marker_tmp"
  ) 2>/dev/null; then
    chmod 0600 "$marker_tmp" 2>/dev/null
    # H1: between writing the temp marker and linking it, the only state in
    # which two acquirers can overlap on a pool that has no marker yet (R10).
    pause_at GATE_LOCK_TEST_PAUSE_BEFORE_FORMAT_LINK
    ln "$marker_tmp" "$marker" 2>/dev/null
    rm -f "$marker_tmp"
  fi
fi
if [ ! -e "$marker" ] && [ ! -h "$marker" ]; then
  die "could not publish the .format marker in $pool (temp write or hard link failed); no lock was taken"
fi
# Read back, trailing newlines trimmed by the command substitution; only a
# regular file (never a symlink, a directory or a fifo, so the -f test comes
# before any read) can say 1. The substitution also drops NUL bytes, so the
# bytes are counted too: after deleting newlines exactly one byte must remain.
found=
extra_bytes=0
if [ -f "$marker" ] && [ ! -h "$marker" ]; then
  # NULs are deleted first: bash warns on stderr about a NUL in a substitution.
  found=$({ tr -d '\000' <"$marker" | cat; } 2>/dev/null) || found=
  marker_bytes=$({ tr -d '\n' <"$marker" | wc -c; } 2>/dev/null) || marker_bytes=0
  [ "$((marker_bytes + 0))" -eq 1 ] || extra_bytes=1
fi
if [ "$found" != 1 ] || [ "$extra_bytes" = 1 ]; then
  if [ "$found" = 1 ]; then
    shown="'1' followed by unexpected bytes"
  elif [ -z "$found" ]; then
    shown=nothing
  else
    shown="'$(printf '%s' "$found" | tr '\n' ' ' | cut -c1-64)'"
  fi
  die "$pool_label has lock format $shown, but this gate speaks 1; no lock was taken$pool_hint"
fi

# --- Stale threshold (F36, V20) and heartbeat period (D5) ------------------------

stale_raw=${GATE_LOCK_STALE_SECONDS:-}
if [ -z "$stale_raw" ]; then
  stale_seconds=600
else
  is_digits "$stale_raw" || die "GATE_LOCK_STALE_SECONDS must be a whole number of seconds (at most 10 digits), got '$stale_raw'"
  strip_zeros "$stale_raw"
  case $norm in
  ???????????*) die "GATE_LOCK_STALE_SECONDS must be a whole number of seconds (at most 10 digits), got '$stale_raw'" ;;
  esac
  [ "$norm" -ge 600 ] ||
    die "GATE_LOCK_STALE_SECONDS=$stale_raw is below 600s; under a pool the stale threshold must be at least 600s"
  stale_seconds=$norm
fi

beat_raw=${GATE_LOCK_HEARTBEAT_SECONDS:-}
if [ -z "$beat_raw" ]; then
  heartbeat_seconds=60
else
  is_digits "$beat_raw" || die "GATE_LOCK_HEARTBEAT_SECONDS must be a whole number of seconds, at least 1 and at most 10 digits, got '$beat_raw'"
  strip_zeros "$beat_raw"
  case $norm in
  ???????????*) die "GATE_LOCK_HEARTBEAT_SECONDS must be a whole number of seconds, at least 1 and at most 10 digits, got '$beat_raw'" ;;
  esac
  [ "$norm" -ge 1 ] || die "GATE_LOCK_HEARTBEAT_SECONDS must be a whole number of seconds, at least 1 and at most 10 digits, got '$beat_raw'"
  heartbeat_seconds=$norm
fi

# --- Worker agreement (V9, D22) ----------------------------------------------------

host_workers_raw=${GATE_HOST_WORKERS:-}
host_workers_norm=
host_workers_n=
if [ -n "$host_workers_raw" ]; then
  parse_workers GATE_HOST_WORKERS "$host_workers_raw"
  host_workers_norm=$workers_norm
  host_workers_n=$workers_n
fi
if [ "${GATE_LOCK_WORKERS+set}" = set ]; then
  # Set but empty or unusable is refused, never read as unset (D22).
  cap_validate GATE_LOCK_WORKERS "$GATE_LOCK_WORKERS" GATE_LOCK_SLOTS
  if [ -n "$host_workers_raw" ] && [ "$norm" != "$host_workers_norm" ]; then
    die "GATE_LOCK_WORKERS=$GATE_LOCK_WORKERS does not match GATE_HOST_WORKERS=$host_workers_raw; a run's cap and the host's budget are one decision"
  fi
fi

# --- Slot count (V8-V12), budget (V13), disagreement (V15) --------------------------

project_slots=
if [ -n "${GATE_LOCK_SLOTS:-}" ]; then
  parse_slots GATE_LOCK_SLOTS "$GATE_LOCK_SLOTS"
  project_slots=$slots_n
fi
slot_source=
if [ -n "${GATE_HOST_SLOTS:-}" ]; then
  parse_slots GATE_HOST_SLOTS "$GATE_HOST_SLOTS"
  slot_count=$slots_n
  slot_source="GATE_HOST_SLOTS=$GATE_HOST_SLOTS"
elif [ -n "$host_workers_raw" ]; then
  get_procs
  [ "$procs_ok" = 1 ] ||
    die "cannot derive a slot count from GATE_HOST_WORKERS=$host_workers_raw: getconf _NPROCESSORS_ONLN did not give a number (got '$procs_raw'); set GATE_HOST_SLOTS, or unset GATE_HOST_WORKERS"
  slot_count=$((procs_n / host_workers_n))
  [ "$slot_count" -ge 1 ] || slot_count=1
  [ "$slot_count" -le 64 ] || slot_count=64
  slot_source="GATE_HOST_WORKERS=$host_workers_raw"
else
  slot_count=${project_slots:-1}
fi

if [ -n "${GATE_HOST_SLOTS:-}" ] && [ -n "$host_workers_raw" ]; then
  get_procs
  [ "$procs_ok" = 1 ] ||
    die "GATE_HOST_SLOTS=$GATE_HOST_SLOTS with GATE_HOST_WORKERS=$host_workers_raw can only be checked against the host's processor count, but getconf _NPROCESSORS_ONLN did not give a number (got '$procs_raw')"
  fit=$((procs_n / host_workers_n))
  [ "$slot_count" -le "$fit" ] ||
    die "GATE_HOST_SLOTS=$GATE_HOST_SLOTS with GATE_HOST_WORKERS=$host_workers_raw does not fit the $procs_n processors of this host (at most $fit slots of that many workers); lower the slots, raise the workers, or unset GATE_HOST_WORKERS and let the slot count be derived"
fi

if [ -n "$project_slots" ] && [ -n "$slot_source" ] && [ "$project_slots" -ne "$slot_count" ]; then
  die "GATE_LOCK_SLOTS=$GATE_LOCK_SLOTS does not match $slot_source, which gives $slot_count slots, for pool $pool; the host's count wins in a pool"
fi

# The resolved configuration, read by the subcommands below: $pool $slot_count
# $stale_seconds $heartbeat_seconds $real_uid $leaf_uid.

# ---------------------------------------------------------------------------
# Slot helpers
# ---------------------------------------------------------------------------

base=$pool/gate.lock

# The uid a slot must be owned by (F59a). The pool leaf shares the expected-uid
# seam (H10), so a test cannot make a slot foreign without making the pool
# foreign too; GATE_LOCK_TEST_SLOT_UID judges slots alone. Empty is inert.
slot_uid=$leaf_uid
seam GATE_LOCK_TEST_SLOT_UID
[ -z "$seam_value" ] || slot_uid=$seam_value
is_digits "$slot_uid" || die "GATE_LOCK_TEST_SLOT_UID must be a numeric user id"

fail1() {
  printf 'gate-lock: %s\n' "$*" >&2
  exit 1
}

usage_error() {
  printf 'gate-lock: %s\nusage: gate-lock acquire <lane> | release <lane> | verify <lane> | heartbeat | status [--json] | clean | run [options] <lane> -- <command...> | workers\n' "$1" >&2
  exit 2
}

# now_s: the clock in epoch seconds, as digits, in $now. The test seam
# GATE_LOCK_TEST_NOW fixes it, so the threshold boundary can be hit exactly.
now_s() {
  seam GATE_LOCK_TEST_NOW
  if [ -n "$seam_value" ]; then
    now=$seam_value
  else
    now=$(date +%s 2>/dev/null) || now=
  fi
  is_digits "$now" || die "cannot read the clock (date +%s gave '$now')"
}

# rdf FILE: the first line of a regular file (not a symlink), without its
# newline, in $rd; empty on any failure.
rdf() {
  rd=
  if [ -f "$1" ] && [ ! -h "$1" ]; then
    IFS= read -r rd <"$1" 2>/dev/null || :
  fi
}

# pid_alive PID (F41, D3): signal zero on a digits-only, non-zero pid of at most
# ten digits. Any failure, EPERM included, is "not alive".
pid_alive() {
  is_digits "$1" || return 1
  case $1 in
  ???????????*) return 1 ;;
  esac
  strip_zeros "$1"
  [ "$norm" != 0 ] || return 1
  kill -0 "$norm" 2>/dev/null
}

# pid_eq A B: both are pids and equal once leading zeros are a spelling.
pid_eq() {
  if ! is_digits "$1" || ! is_digits "$2"; then
    return 1
  fi
  strip_zeros "$1"
  pe_a=$norm
  strip_zeros "$2"
  [ "$pe_a" = "$norm" ]
}

# judge_beat BEAT (F35, F37, D4, D5): needs $now. Sets $beat_state (fresh, stale,
# missing or future), $beat_fresh (1 for fresh and future) and $beat_delta
# (seconds in the future, for a future beat of at most ten digits).
judge_beat() {
  beat_state=stale
  beat_fresh=0
  beat_delta=
  if [ -z "$1" ]; then
    beat_state=missing
    return 0
  fi
  is_digits "$1" || return 0
  case $1 in
  ???????????*)
    # More than ten digits: far in the future, never stale (D5).
    beat_state=future
    beat_fresh=1
    return 0
    ;;
  esac
  strip_zeros "$1"
  if [ "$norm" -gt "$now" ]; then
    beat_state=future
    beat_fresh=1
    beat_delta=$((norm - now))
  elif [ "$((now - norm))" -ge "$stale_seconds" ]; then
    beat_state=stale
  else
    beat_state=fresh
    beat_fresh=1
  fi
}

# slot_path N: sets $sp to the path of slot N (F18).
slot_path() {
  if [ "$1" -eq 0 ]; then
    sp=$base
  else
    sp=$base.$1
  fi
}

# canonical_slot PATH (F19, F57): the slot name, or the slot name plus a dot and
# one or two digits with no leading zero, below 64. The spelling is judged as
# given: a trailing slash or a ./.. component is never normalised away.
canonical_slot() {
  case $1 in
  "$base") return 0 ;;
  "$base".*) cs_n=${1#"$base".} ;;
  *) return 1 ;;
  esac
  case $cs_n in
  [1-9]) return 0 ;;
  [1-9][0-9]) [ "$cs_n" -lt 64 ] ;;
  *) return 1 ;;
  esac
}

# slot_valid PATH (F57-F59a): the canonical and provenance filters, in order:
# canonical name, not a symlink (first, and on its own, because an owner query
# on a link reports the link's own owner), a directory, owned by the expected uid.
slot_valid() {
  canonical_slot "$1" || return 1
  [ ! -h "$1" ] || return 1
  [ -d "$1" ] || return 1
  owned_by "$1" "$slot_uid"
}

# read_slot DIR: the slot's files in $s_owner $s_pid $s_started $s_beat
# $s_worktree $s_project (empty on any read failure).
read_slot() {
  rdf "$1/owner"
  s_owner=$rd
  rdf "$1/pid"
  s_pid=$rd
  rdf "$1/started"
  s_started=$rd
  rdf "$1/beat"
  s_beat=$rd
  rdf "$1/worktree"
  s_worktree=$rd
  rdf "$1/project"
  s_project=$rd
}

# check_label LABEL (D14, Q14): the owner file is one line, so a label is
# accepted only when it can be read back and compared: printable ASCII (space
# to tilde) under LC_ALL=C, which excludes a newline and every control
# character, and at most 128 bytes. ${#label} counts bytes because LC_ALL=C is
# exported above. A refusal is exit 2 and happens before anything is taken.
check_label() {
  cl_bytes=${#1}
  if [ "$cl_bytes" -gt 128 ]; then
    die "the lane label must be at most 128 bytes, got $cl_bytes; the owner file is one line of the slot and is compared byte for byte"
  fi
  case $1 in
  *[!\ -~]*)
    die "the lane label must be printable ASCII (space to ~, so no newline and no control character); it is written to the slot's owner file as one line"
    ;;
  esac
}

# need_caller WHAT: GATE_LOCK_CALLER_PID is required (C6) and must be a pid of
# at most ten digits (D5). Sets $caller without leading zeros.
need_caller() {
  caller_raw=${GATE_LOCK_CALLER_PID:-}
  if [ -z "$caller_raw" ]; then
    if [ "$1" = acquire ]; then
      die "acquire needs GATE_LOCK_CALLER_PID, the pid of the long-lived process the lock is for; a bare acquire would record this short-lived process and the lock would be reclaimable at once; use 'gate-lock run <lane> -- <command>' instead"
    fi
    die "$1 needs GATE_LOCK_CALLER_PID, the pid that holds the lock"
  fi
  is_digits "$caller_raw" || die "GATE_LOCK_CALLER_PID must be a process id (digits, at most 10), got '$caller_raw'"
  case $caller_raw in
  ???????????*) die "GATE_LOCK_CALLER_PID must be a process id (digits, at most 10), got '$caller_raw'" ;;
  esac
  strip_zeros "$caller_raw"
  caller=$norm
  [ "$caller" != 0 ] ||
    die "GATE_LOCK_CALLER_PID must be a non-zero process id, got '$caller_raw'; a pid of zero is never alive, so the lock would be reclaimable at once"
  if [ "$1" = acquire ] && ! pid_alive "$caller"; then
    die "GATE_LOCK_CALLER_PID=$caller is not a live process; the lock would be reclaimable the moment it was taken, so none was taken"
  fi
}

# resolve_pin (F62-F65): GATE_LOCK_SLOT_PATH is a claim from the environment.
# Sets $pin (empty when there is none). A bad pin is exit 2, never exit 1 (F65).
resolve_pin() {
  pin=${GATE_LOCK_SLOT_PATH:-}
  [ -n "$pin" ] || return 0
  canonical_slot "$pin" ||
    die "GATE_LOCK_SLOT_PATH=$pin is not a slot on this host (the pool here is $pool); no action was taken"
  if [ -e "$pin" ] || [ -h "$pin" ]; then
    slot_valid "$pin" ||
      die "GATE_LOCK_SLOT_PATH=$pin is not a valid slot (a symlink, not a directory, or not owned by uid $slot_uid); it was left alone"
  fi
}

# find_slot MODE: the slot the caller means. Sets $target. A pin wins; without
# one, the first filtered slot (slots 0..63, never a glob) whose pid equals the
# caller's (MODE pid) or whose owner and pid both match $lane (MODE owner). With
# no match $target is empty.
find_slot() {
  target=
  if [ -n "$pin" ]; then
    target=$pin
    return 0
  fi
  fs_n=0
  while [ "$fs_n" -lt 64 ]; do
    slot_path "$fs_n"
    if slot_valid "$sp"; then
      rdf "$sp/pid"
      if pid_eq "$rd" "$caller"; then
        if [ "$1" = pid ]; then
          target=$sp
          return 0
        fi
        rdf "$sp/owner"
        if [ "$rd" = "$lane" ]; then
          target=$sp
          return 0
        fi
      fi
    fi
    fs_n=$((fs_n + 1))
  done
}

# aside_ok DIR: what was moved aside is a real directory, not a symlink, owned by
# the expected uid (the slot provenance filters, F58-F59a, applied to the aside).
# Nothing is ever deleted through a symlink or a foreign directory.
aside_ok() {
  if [ -h "$1" ] || [ ! -d "$1" ]; then
    return 1
  fi
  owned_by "$1" "$slot_uid"
}

# restore_to SRC DST: rename SRC to DST when DST is free (return 0). A third
# party can create DST between the test and the mv (H, GATE_LOCK_TEST_PAUSE_BEFORE_RESTORE_MV),
# and mv onto an existing directory moves SRC inside it: that is detected, SRC is
# moved back out to where it was, and 1 is returned. Never deletes anything.
restore_to() {
  if [ -e "$2" ] || [ -h "$2" ]; then
    return 1
  fi
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_RESTORE_MV
  mv "$1" "$2" 2>/dev/null || return 1
  if [ -d "$2/${1##*/}" ]; then
    mv "$2/${1##*/}" "$1" 2>/dev/null
    return 1
  fi
  return 0
}

# take_aside SLOT TAG (D12): rename SLOT to a free aside name, SLOT.reclaim.<own
# pid>.<TAG> (a numeric suffix is added while the name is taken), and detect
# nesting. Sets $aside. Returns 0 when the slot is now at $aside, 1 when the
# rename failed, 2 when the rename nested the slot inside something that already
# existed at the aside name (it is moved back when the name is free, never
# deleted; a message is printed), 3 when the slot holds an entry named like the
# slot itself: a non-standard slot, whose nesting could not be told from that
# entry, so it is not touched.
take_aside() {
  ta_slot=$1
  ta_base=${ta_slot##*/}
  if [ -d "$ta_slot/$ta_base" ]; then
    printf 'gate-lock: %s contains an entry named %s, so it is not a standard slot and is not touched\n' "$ta_slot" "$ta_base" >&2
    return 3
  fi
  ta_k=0
  while :; do
    if [ "$ta_k" -eq 0 ]; then
      aside=$ta_slot.reclaim.$$.$2
    else
      aside=$ta_slot.reclaim.$$.$2.$ta_k
    fi
    if [ ! -e "$aside" ] && [ ! -h "$aside" ]; then
      break
    fi
    ta_k=$((ta_k + 1))
    [ "$ta_k" -le 99 ] || return 1
  done
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_ASIDE
  mv "$ta_slot" "$aside" 2>/dev/null || return 1
  # mv onto an existing directory moves the source inside it and exits 0 (D11).
  if [ -d "$aside/$ta_base" ]; then
    if restore_to "$aside/$ta_base" "$ta_slot"; then
      printf 'gate-lock: reclaim aborted: %s was moved inside %s, which already existed; the slot was restored\n' "$ta_slot" "$aside" >&2
    else
      printf 'gate-lock: reclaim aborted: %s was moved inside %s, which already existed; the moved copy is at %s/%s and is never deleted\n' "$ta_slot" "$aside" "$aside" "$ta_base" >&2
    fi
    return 2
  fi
  return 0
}

# put_back ASIDE SLOT VERB WHY: rename what was moved aside back to its name when
# the name is free (return 0); otherwise leave it and say so (return 1). Never
# deletes. VERB (reclaim, release or give-back) names the operation in the
# message; WHY is "different" (the moved slot was not the one judged or checked)
# or "failed" (the removal failed part way).
put_back() {
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_RESTORE
  pb_what=checked
  [ "$3" != reclaim ] || pb_what=judged
  if restore_to "$1" "$2"; then
    if [ "$4" = failed ]; then
      printf 'gate-lock: %s aborted: %s could not be removed; the slot was put back\n' "$3" "$2" >&2
    else
      printf 'gate-lock: %s aborted: %s held a different slot than the one %s; it was restored\n' "$3" "$2" "$pb_what" >&2
    fi
    return 0
  fi
  if [ "$4" = failed ]; then
    printf 'gate-lock: %s aborted: %s could not be removed; the slot was left at %s and is never deleted\n' "$3" "$2" "$1" >&2
  else
    printf 'gate-lock: %s aborted: %s held a different slot than the one %s; the moved copy was left at %s and is never deleted\n' "$3" "$2" "$pb_what" "$1" >&2
  fi
  return 1
}

# remove_if_ours SLOT OWNER PID VERB (D12, F60): remove SLOT only if it still
# names OWNER and PID, by renaming it aside first, verifying what moved, and
# then deleting the aside. Only two values are verified, not the three a
# reclaim compares: the holder's own heartbeat moves the beat at any moment, so
# a beat comparison would refuse a legitimate release. A different slot, or a
# moved object that is a symlink or not ours, is put back. Returns 0 removed, 1
# the slot is not ours (nothing deleted; $found_owner and $found_pid are set),
# 2 it could not be removed (it was put back when the name was free), 4 it was
# already gone. put_back's own messages go to stderr: that is where a release
# that left a copy aside must say so.
remove_if_ours() {
  ri_slot=$1
  if [ ! -e "$ri_slot" ] && [ ! -h "$ri_slot" ]; then
    return 4
  fi
  take_aside "$ri_slot" rel
  ri_rc=$?
  if [ "$ri_rc" -eq 2 ] || [ "$ri_rc" -eq 3 ]; then
    return 2
  fi
  if [ "$ri_rc" -ne 0 ]; then
    if [ ! -e "$ri_slot" ] && [ ! -h "$ri_slot" ]; then
      return 4
    fi
    return 2
  fi
  found_owner=
  found_pid=
  if ! aside_ok "$aside"; then
    put_back "$aside" "$ri_slot" "$4" different || :
    return 1
  fi
  rdf "$aside/owner"
  found_owner=$rd
  rdf "$aside/pid"
  found_pid=$rd
  if [ "$found_owner" != "$2" ] || ! pid_eq "$found_pid" "$3"; then
    put_back "$aside" "$ri_slot" "$4" different || :
    return 1
  fi
  # H7 (before-release): after the owner and pid check, before the removal, so
  # a test can hold the process in the window a second signal used to break.
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_RELEASE
  rm -rf "${aside:?}" 2>/dev/null
  if [ -e "$aside" ] || [ -h "$aside" ]; then
    put_back "$aside" "$ri_slot" "$4" failed || :
    return 2
  fi
  return 0
}

# names_in DIR: the entry names in DIR, space separated, in $names_list.
names_in() {
  names_list=
  for ni_f in "$1"/* "$1"/.[!.]*; do
    if [ -e "$ni_f" ] || [ -h "$ni_f" ]; then
      names_list="$names_list ${ni_f##*/}"
    fi
  done
  names_list=${names_list# }
}

# json_str VALUE: a JSON string. Bytes outside printable ASCII become "?" (a
# lossy but always valid encoding); backslash and double quote are escaped.
json_str() {
  printf '"%s"' "$(printf '%s' "$1" | tr -c ' -~' '?' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# ---------------------------------------------------------------------------
# The janitor (D16, Q16): the `clean` subcommand, also run at the start of
# acquire and never on status (C27).
#
# A transient (F20, F23) goes only when its embedded pid is dead AND it is at
# least a stale threshold old. The age is judged with `touch -t` on a reference
# file plus `find <x> -prune ! -newer <ref>`, so no `stat` is needed and the
# threshold is the same one every reader uses (F35). A `.reclaim.*` aside goes
# only when, additionally, F40 judges what it holds not alive: the recorded
# holder is dead, or its beat is stale.
# ---------------------------------------------------------------------------
# touch_stamp EPOCH: a `touch -t` stamp for EPOCH, in $stamp. Both sides are UTC
# (L7 has no monotonic source either), so a daylight-saving transition between
# now and the reference cannot shift the reference by an hour: a local stamp
# read from one zone and written in another is not an instant, and a wall clock
# inside a spring-forward gap does not exist at all.
# `date +%s` is portable, converting an epoch to a broken-down time is not:
# GNU and busybox read `date -d @N`, BSD and macOS `date -r N`. When neither is
# available the janitor removes nothing at all, which is the safe answer (the
# age half of the condition cannot be judged, so nothing is).
touch_stamp() {
  stamp=$(TZ=UTC0 date -u -d "@$1" +%Y%m%d%H%M.%S 2>/dev/null) || stamp=
  if [ -z "$stamp" ]; then
    stamp=$(TZ=UTC0 date -u -r "$1" +%Y%m%d%H%M.%S 2>/dev/null) || stamp=
  fi
}

# janitor_ref: create the age reference file and set $ja_ref to its path.
# Returns 1 when it cannot be created or aged, which makes the whole pass a
# no-op. The file lives in a temp directory, not in the pool: it is not a
# transient, so a leftover in the pool would never be cleaned up (Q16). The
# directory is the same one the pool resolver trusts (tmp_trusted), because a
# reference another user could replace would make every transient look old.
janitor_ref() {
  touch_stamp "$((now - stale_seconds))"
  [ -n "$stamp" ] || return 1
  tmp_root || return 1
  [ -n "$tmp_phys" ] || return 1
  ja_ref=$tmp_phys/.gate-lock-janitor.$$
  ja_k=0
  while [ "$ja_k" -le 20 ]; do
    if [ "$ja_k" -eq 0 ]; then
      ja_try=$ja_ref
    else
      ja_try=$ja_ref.$ja_k
    fi
    # noclobber: a name that is already there is somebody else's, and is never
    # removed. A leftover of a dead process that had our pid just costs the
    # next free suffix.
    if [ ! -e "$ja_try" ] && [ ! -h "$ja_try" ]; then
      if (
        set -C
        : >"$ja_try"
      ) 2>/dev/null; then
        chmod 0600 "$ja_try" 2>/dev/null
        ja_ref=$ja_try
        if ! TZ=UTC0 touch -t "$stamp" "$ja_ref" 2>/dev/null; then
          rm -f "$ja_ref" 2>/dev/null
          return 1
        fi
        # The last chance to notice a replaced reference: what we are about to
        # trust is a plain, private file of ours, not a link and not a
        # directory (the tmp_trusted directory already makes a plant hard, and
        # a same-uid plant is out of this tool's threat model, P7).
        pause_at GATE_LOCK_TEST_PAUSE_AFTER_JANITOR_REF
        if [ -h "$ja_ref" ] || [ ! -f "$ja_ref" ] || ! owned_by "$ja_ref" "$real_uid"; then
          rm -f "$ja_ref" 2>/dev/null
          return 1
        fi
        return 0
      fi
    fi
    ja_k=$((ja_k + 1))
  done
  return 1
}

# janitor_name NAME (D16, F19-F23): sets $j_kind (cand, beatnew, formattmp or
# reclaim), $j_pid (the creating process) and $j_slot when NAME is a transient
# of a canonical slot, or of the pool marker. $j_kind is empty for everything
# else, and then nothing is ever done with the name: a name that merely looks
# like a transient is somebody else's.
janitor_name() {
  j_kind=
  j_pid=
  j_slot=
  case $1 in
  .format.tmp.*)
    # F23: the marker temp lives in the pool root, not beside a slot.
    j_kind=formattmp
    j_tail=${1#.format.tmp.}
    ;;
  *.cand.*)
    j_kind=cand
    j_slot=${1%%.cand.*}
    j_tail=${1#*.cand.}
    ;;
  *.beatnew.*)
    j_kind=beatnew
    j_slot=${1%%.beatnew.*}
    j_tail=${1#*.beatnew.}
    ;;
  *.reclaim.*)
    # `.reclaim.<pid>.<pass>`, where the token after the pid is opaque (D12):
    # readers match the pid only and never assume the shape of the token.
    j_kind=reclaim
    j_slot=${1%%.reclaim.*}
    j_rest=${1#*.reclaim.*}
    case $j_rest in
    *.*) j_tail=${j_rest%%.*} ;;
    *) j_kind= ;;
    esac
    ;;
  *) j_kind= ;;
  esac
  [ -n "$j_kind" ] || return 0
  if [ "$j_kind" != formattmp ]; then
    # A transient hangs off a canonical slot name (F19, F21): the shape rule,
    # not the position, is what keeps a transient out of the slot set.
    canonical_slot "$pool/$j_slot" || j_kind=
    [ -n "$j_kind" ] || return 0
  fi
  is_digits "$j_tail" || j_kind=
  [ -n "$j_kind" ] || return 0
  strip_zeros "$j_tail"
  # A pid of zero is not a process, so the name is not one of ours.
  [ "$norm" != 0 ] || j_kind=
  [ -n "$j_kind" ] || return 0
  j_pid=$norm
}

# janitor_pass: one pass over the pool's entries. Prints `janitor: removed
# <name>` for each removal.
janitor_pass() {
  now_s
  janitor_ref || return 0
  for jp_path in "$pool"/* "$pool"/.[!.]*; do
    if [ ! -e "$jp_path" ] && [ ! -h "$jp_path" ]; then
      continue
    fi
    jp_name=${jp_path##*/}
    janitor_name "$jp_name"
    [ -n "$j_kind" ] || continue
    jp_file=$pool/$jp_name
    # Provenance first, so nothing is even looked at that is a symlink or is
    # not ours: nothing is ever deleted through a link or a foreign directory.
    if [ "$j_kind" = cand ] || [ "$j_kind" = reclaim ]; then
      aside_ok "$jp_file" || continue
    else
      [ ! -h "$jp_file" ] || continue
      [ -f "$jp_file" ] || continue
      owned_by "$jp_file" "$slot_uid" || continue
    fi
    # The creator must be gone. A recycled pid makes this judge a new process
    # dead, and the transient it is filling is taken: its write then fails
    # (F31), create_slot answers "not won", and the creator retries the pass
    # (D16). Nothing is lost, and no slot was ever misjudged.
    if pid_alive "$j_pid"; then
      continue
    fi
    # Older than the stale threshold: mtime at or before the reference.
    if [ -z "$(find "$jp_file" -prune ! -newer "$ja_ref" -print 2>/dev/null)" ]; then
      continue
    fi
    if [ "$j_kind" = reclaim ]; then
      # What the aside holds is judged by F40, exactly as any other reader
      # would: a dead holder, or a beat that is stale or missing. The two values
      # are read and read again, and only a pair of reads that agree is judged,
      # so a slot replaced under the janitor is never removed on a half-read.
      rdf "$jp_file/pid"
      jp_pid=$rd
      rdf "$jp_file/beat"
      jp_beat=$rd
      pause_at GATE_LOCK_TEST_PAUSE_AFTER_JANITOR_CONTENTS
      rdf "$jp_file/pid"
      if [ "$rd" != "$jp_pid" ]; then
        continue
      fi
      rdf "$jp_file/beat"
      if [ "$rd" != "$jp_beat" ]; then
        continue
      fi
      jp_alive=0
      pid_alive "$jp_pid" && jp_alive=1
      judge_beat "$jp_beat"
      if [ "$jp_alive" = 1 ] && [ "$beat_fresh" = 1 ]; then
        continue
      fi
    fi
    # The last look before removing: the name must still be the transient this
    # pass judged, still a plain thing of ours. Anything else is left alone and
    # judged on its own turn.
    pause_at GATE_LOCK_TEST_PAUSE_BEFORE_JANITOR_REMOVE
    if [ "$j_kind" = cand ] || [ "$j_kind" = reclaim ]; then
      aside_ok "$jp_file" || continue
    else
      [ ! -h "$jp_file" ] || continue
      [ -f "$jp_file" ] || continue
      owned_by "$jp_file" "$slot_uid" || continue
    fi
    if [ "$j_kind" = cand ] || [ "$j_kind" = reclaim ]; then
      rm -rf "${jp_file:?}" 2>/dev/null
    else
      rm -f "$jp_file" 2>/dev/null
    fi
    if [ ! -e "$jp_file" ] && [ ! -h "$jp_file" ]; then
      printf 'gate-lock: janitor: removed %s\n' "$jp_name"
    fi
  done
  rm -f "$ja_ref" 2>/dev/null
  return 0
}

# ---------------------------------------------------------------------------
# acquire (C6-C12, F43-F67)
# ---------------------------------------------------------------------------

# resolve_identity (F28, F55): the git top-level of the working directory, else
# the physical working directory; empty is refused.
resolve_identity() {
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_IDENTITY
  wt=
  if CDPATH='' cd -- . 2>/dev/null; then
    wt=$(pwd -P 2>/dev/null) || wt=
  fi
  if [ -n "$wt" ] && command -v git >/dev/null 2>&1; then
    top=$( (
      unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
      git rev-parse --show-toplevel
    ) 2>/dev/null) || top=
    [ -z "$top" ] || wt=$top
  fi
  [ -n "$wt" ] ||
    die "cannot determine the caller's worktree (the working directory is unreadable or was removed); no lock was taken"
}

# slot_out_check (D21): GATE_LOCK_SLOT_OUT is judged before the slot loop, so a
# refusal takes nothing. Sets $out (empty: none), $out_mode (inplace or rename)
# and, for rename, $out_final.
out=
out_mode=
out_final=
slot_out_check() {
  out=${GATE_LOCK_SLOT_OUT:-}
  [ -n "$out" ] || return 0
  if [ -h "$out" ]; then
    die "GATE_LOCK_SLOT_OUT=$out is a symlink; name a regular file you own or a new path; no lock was taken"
  fi
  if [ -e "$out" ]; then
    if [ -f "$out" ] && owned_by "$out" "$real_uid"; then
      out_mode=inplace
      return 0
    fi
    die "GATE_LOCK_SLOT_OUT=$out exists but is not a regular file owned by uid $real_uid; no lock was taken"
  fi
  case $out in
  */) die "GATE_LOCK_SLOT_OUT=$out ends with a slash; name a file; no lock was taken" ;;
  esac
  case $out in
  */*) so_dir=${out%/*} ;;
  *) so_dir=. ;;
  esac
  [ -n "$so_dir" ] || so_dir=/
  so_phys=$(CDPATH='' cd -- "$so_dir" 2>/dev/null && pwd -P) ||
    die "GATE_LOCK_SLOT_OUT=$out: the directory $so_dir does not exist; no lock was taken"
  if ! owned_by "$so_phys" "$real_uid" || ! not_group_other_writable "$so_phys"; then
    die "GATE_LOCK_SLOT_OUT=$out: its directory $so_phys must be owned by uid $real_uid and not writable by group or others; no lock was taken"
  fi
  if [ "$so_phys" = / ]; then
    out_final=/${out##*/}
  else
    out_final=$so_phys/${out##*/}
  fi
  out_mode=rename
}

# write_slot_out SLOT: record the slot path (C9). Returns 1 on failure.
write_slot_out() {
  [ -n "$out" ] || return 0
  case $out_mode in
  inplace)
    # Keep the caller's inode; re-check immediately before writing.
    if [ -h "$out" ] || [ ! -f "$out" ]; then
      return 1
    fi
    printf '%s\n' "$1" >"$out" 2>/dev/null
    ;;
  rename)
    # A fresh temp name, created exclusively (noclobber): a file already at a
    # candidate name is somebody else's and is never removed; only a temp this
    # process created is ever cleaned up.
    wo_k=0
    wo_tmp=
    while [ "$wo_k" -le 20 ]; do
      if [ "$wo_k" -eq 0 ]; then
        wo_try=$out_final.tmp.$$
      else
        wo_try=$out_final.tmp.$$.$wo_k
      fi
      if [ ! -e "$wo_try" ] && [ ! -h "$wo_try" ]; then
        if (
          set -C
          printf '%s\n' "$1" >"$wo_try"
        ) 2>/dev/null; then
          wo_tmp=$wo_try
          break
        fi
      fi
      wo_k=$((wo_k + 1))
    done
    [ -n "$wo_tmp" ] || return 1
    chmod 0600 "$wo_tmp" 2>/dev/null
    if [ -d "$out_final" ] || ! mv -f "$wo_tmp" "$out_final" 2>/dev/null; then
      rm -f "$wo_tmp" 2>/dev/null
      return 1
    fi
    ;;
  esac
}

# self_held_check (F67): a caller pid that already holds an answering slot, in
# any filtered slot (beyond the configured count too), is refused (exit 2).
self_held_check() {
  sh_n=0
  while [ "$sh_n" -lt 64 ]; do
    slot_path "$sh_n"
    if slot_valid "$sp"; then
      rdf "$sp/pid"
      if pid_eq "$rd" "$caller" && pid_alive "$rd"; then
        rdf "$sp/beat"
        now_s
        judge_beat "$rd"
        if [ "$beat_fresh" = 1 ]; then
          die "pid $caller already holds $sp; a holder that takes a second slot leaves the first with nothing refreshing it"
        fi
      fi
    fi
    sh_n=$((sh_n + 1))
  done
}

# remember_holder OWNER PID BEAT SLOT KIND: keep the first holder seen, for the
# busy line (F54).
h_owner=
h_pid=
h_beat=
h_slot=
h_kind=
remember_holder() {
  # The first holder is kept, but a real holder replaces a forged placeholder
  # (something at a slot name that is not a slot): the busy line names a holder
  # whenever one exists (kind: real or forged, in $5).
  if [ -n "$h_slot" ]; then
    if [ "$h_kind" != forged ] || [ "$5" != real ]; then
      return 0
    fi
  fi
  h_owner=$1
  h_pid=$2
  h_beat=$3
  h_slot=$4
  h_kind=$5
}

# put_file NAME VALUE: one line into the candidate, mode 0600 (D23). The whole
# write is a group with stderr redirected: a redirection into a candidate that
# has just been removed is reported by the shell itself, before the command
# runs, and `2>/dev/null` on the command alone would not hide that.
put_file() {
  {
    printf '%s\n' "$2" >"$cs_cand/$1" && chmod 0600 "$cs_cand/$1" 2>/dev/null
  } 2>/dev/null
}

# create_slot SLOT (F31-F32, R1, R2): fill a candidate with the six files, rename
# it onto the slot name, detect nesting, read back. Returns 0 when the name was
# won, 1 when not (try again on the next pass), 2 when the candidate could not
# even be made here, which is a pool problem and not a busy name.
create_slot() {
  cs_slot=$1
  cs_cand=$cs_slot.cand.$$
  # A leftover of a dead process that had our pid (a pid-recycle race); ours now.
  rm -rf "$cs_cand" 2>/dev/null
  mkdir -m 0700 "$cs_cand" 2>/dev/null || return 2
  now_s
  pause_at GATE_LOCK_TEST_PAUSE_AFTER_CANDIDATE_MKDIR
  if ! {
    put_file owner "$lane" && put_file pid "$caller" && put_file started "$now" &&
      put_file beat "$now" && put_file worktree "$wt" && put_file project "${wt##*/}"
  }; then
    if [ ! -d "$cs_cand" ]; then
      # The candidate is gone and we did not remove it: a janitor pass of another
      # process judged this pid dead - it had not been reused by this process
      # yet - and took the directory (D16). The pool is writable, so this is
      # "not won", not a refusal: the next pass makes a new candidate.
      return 1
    fi
    rm -rf "${cs_cand:?}" 2>/dev/null
    return 2
  fi
  # A symlink at the name is never created through (mv would follow it).
  if [ -h "$cs_slot" ]; then
    rm -rf "${cs_cand:?}" 2>/dev/null
    return 1
  fi
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_CREATE_RENAME
  if ! mv "$cs_cand" "$cs_slot" 2>/dev/null; then
    rm -rf "$cs_cand" 2>/dev/null
    return 1
  fi
  # mv onto an existing directory nests the candidate inside it and exits 0: it
  # must be taken out again, and the name was not won (R2).
  if [ -d "$cs_slot/${cs_cand##*/}" ]; then
    if [ -h "$cs_slot" ]; then
      # The name became a symlink in the window: the candidate went through it.
      # Deleting through a changed path is never done; leave it and say so.
      printf 'gate-lock: candidate %s was moved through a symlink at %s and is left in place, not deleted\n' "${cs_cand##*/}" "$cs_slot" >&2
    else
      rm -rf "${cs_slot:?}/${cs_cand##*/}" 2>/dev/null
    fi
    return 1
  fi
  # F32: the pid at the final name must be ours.
  rdf "$cs_slot/pid"
  [ "$rd" = "$caller" ]
}

# acquire_one SLOT (F43-F51, F53): work one slot through its passes. Returns 0
# when the slot was won, 1 when it is unavailable (held, or contended).
acquire_one() {
  ao_slot=$1
  ao_pass=1
  while :; do
    # F43: every pass begins with an attempt to create.
    create_slot "$ao_slot"
    ao_c=$?
    if [ "$ao_c" -eq 0 ]; then
      return 0
    fi
    if ! slot_valid "$ao_slot"; then
      if [ -e "$ao_slot" ] || [ -h "$ao_slot" ]; then
        # Something is at the name that is not a real slot (a symlink, a file,
        # a foreign directory): never reclaimed, never removed.
        remember_holder unknown none none "$ao_slot" forged
        return 1
      fi
      # Nothing is there. If the candidate could not even be written, the pool
      # is the problem, which is a refusal and not a busy host.
      if [ "$ao_c" -eq 2 ]; then
        die "cannot create a candidate slot in $pool: the pool is not writable (or the disk is full); no lock was taken"
      fi
      # Otherwise the name was released in the meantime: a bounded number of tries.
      if [ "$ao_pass" -ge 5 ]; then
        remember_holder unknown none none "$ao_slot" forged
        return 1
      fi
      ao_pass=$((ao_pass + 1))
      continue
    fi
    # F44: inspect.
    read_slot "$ao_slot"
    j_owner=$s_owner
    j_pid=$s_pid
    j_beat=$s_beat
    now_s
    j_alive=0
    pid_alive "$j_pid" && j_alive=1
    judge_beat "$j_beat"
    # F45: bounded patience for a partial or abandoned slot.
    if [ "$ao_pass" -lt 3 ]; then
      if { [ -z "$j_pid" ] && [ -z "$j_beat" ]; } || { [ "$j_alive" = 1 ] && [ -z "$j_beat" ]; }; then
        seam GATE_LOCK_TEST_MARK_PATIENCE
        if [ -n "$seam_value" ]; then
          : >"$seam_value" 2>/dev/null
        fi
        sleep 1
        ao_pass=$((ao_pass + 1))
        continue
      fi
    fi
    # F46: busy.
    if [ "$j_alive" = 1 ] && [ "$beat_fresh" = 1 ]; then
      remember_holder "${j_owner:-unknown}" "$j_pid" "$j_beat" "$ao_slot" real
      return 1
    fi
    # F47: five passes without winning the name: someone else is reclaiming it.
    if [ "$ao_pass" -ge 5 ]; then
      remember_holder "${j_owner:-unknown}" "${j_pid:-none}" "${j_beat:-none}" "$ao_slot" real
      return 1
    fi
    # F48: announce, before moving anything.
    if [ "$j_alive" = 0 ]; then
      printf 'gate-lock: reclaiming %s: holder %s pid %s is not alive\n' "$ao_slot" "${j_owner:-unknown}" "${j_pid:-none}"
    else
      printf 'gate-lock: reclaiming %s: holder %s pid %s heartbeat is stale or missing (beat %s, threshold %ss)\n' "$ao_slot" "${j_owner:-unknown}" "$j_pid" "${j_beat:-missing}" "$stale_seconds"
    fi
    pause_at GATE_LOCK_TEST_PAUSE_AFTER_INSPECT
    # F49: rename aside (D12: a free aside name, nesting detected).
    take_aside "$ao_slot" "$ao_pass"
    ao_rc=$?
    if [ "$ao_rc" -eq 3 ]; then
      # A non-standard slot (an entry named like itself): left alone.
      remember_holder "${j_owner:-unknown}" "${j_pid:-none}" "${j_beat:-none}" "$ao_slot" real
      return 1
    fi
    if [ "$ao_rc" -eq 0 ]; then
      # F50: verify what moved against what was judged.
      rdf "$aside/owner"
      v_owner=$rd
      rdf "$aside/pid"
      v_pid=$rd
      rdf "$aside/beat"
      v_beat=$rd
      if ! aside_ok "$aside"; then
        # Not a real directory of ours (a symlink, a foreign owner): never
        # deleted, whatever the files it shows.
        put_back "$aside" "$ao_slot" reclaim different || :
      elif [ "$v_owner" = "$j_owner" ] && [ "$v_pid" = "$j_pid" ] && [ "$v_beat" = "$j_beat" ]; then
        rm -rf "${aside:?}" 2>/dev/null
      else
        # F51: a different slot moved; it was never judged and is never deleted.
        put_back "$aside" "$ao_slot" reclaim different || :
      fi
    fi
    ao_pass=$((ao_pass + 1))
  done
}

# same_worktree_scan MYSLOT (F56, F56a): after the read-back that proved the
# slot was won, scan every OTHER canonical, provenance-valid slot - including
# slots beyond the configured count, in either direction, because yielding only
# downwards lets a release re-order two acquirers into one worktree. A rival
# blocks only when its worktree is the caller's and its holder is answering
# (F40: a live pid AND a fresh beat). The scan reads; it never reclaims and
# never alters.
#
# A slot is judged on one *confirmed* generation: its worktree, owner, pid and
# beat are read, read again, and only a pair of reads that agree is judged. A
# slot released and replaced between the reads would otherwise be read as the
# caller's own worktree together with the new holder's live pid and fresh beat,
# and the caller would give its slot back for a rival that is not there. Sets
# $sw_found and, when it is 1, $sw_slot $sw_owner $sw_pid $sw_beat.
same_worktree_scan() {
  sw_found=0
  sw_slot=
  sw_owner=
  sw_pid=
  sw_beat=
  sw_n=0
  while [ "$sw_n" -lt 64 ]; do
    slot_path "$sw_n"
    if [ "$sp" != "$1" ] && slot_valid "$sp"; then
      read_slot "$sp"
      sw_wt=$s_worktree
      sw_owner=$s_owner
      sw_pid=$s_pid
      sw_beat=$s_beat
      if [ -n "$sw_wt" ] && [ "$sw_wt" = "$wt" ]; then
        pause_at GATE_LOCK_TEST_PAUSE_BEFORE_SAME_WORKTREE_CONFIRM
        read_slot "$sp"
        if [ "$s_worktree" != "$sw_wt" ] || [ "$s_owner" != "$sw_owner" ] ||
          [ "$s_pid" != "$sw_pid" ] || [ "$s_beat" != "$sw_beat" ]; then
          # The slot changed hands between the two reads. Nothing is judged on
          # a half-read slot: the generation now there is judged on its own if
          # the scan reaches it again, and its holder is an acquirer that scans
          # us in turn (F56c), so no two gates can run in one worktree.
          sw_n=$((sw_n + 1))
          continue
        fi
        now_s
        sw_alive=0
        pid_alive "$sw_pid" && sw_alive=1
        judge_beat "$sw_beat"
        if [ "$sw_alive" = 1 ] && [ "$beat_fresh" = 1 ]; then
          sw_slot=$sp
          sw_found=1
          return 0
        fi
      fi
    fi
    sw_n=$((sw_n + 1))
  done
}

# give_back MYSLOT (F56, F60): hand a slot this invocation won back to the pool
# because a rival in the same worktree answers. The removal is conditional (the
# owner and pid must still be ours), so a contender that took the name in the
# window keeps its slot; the refusal answer is the same either way (R5).
give_back() {
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_SAME_WORKTREE_GIVE_BACK
  remove_if_ours "$1" "$lane" "$caller" give-back
  case $? in
  0 | 4) return 0 ;;
  1)
    printf 'gate-lock: %s changed hands before it could be given back and was left alone\n' "$1" >&2
    ;;
  *)
    printf 'gate-lock: %s could not be given back and still holds this lock (pid %s); release it with GATE_LOCK_CALLER_PID=%s\n' "$1" "$caller" "$caller" >&2
    ;;
  esac
  return 0
}

do_acquire() {
  lane=$1
  # D14: a label that cannot be stored in a one-line file is refused before
  # anything is taken, so nothing is ever written with it.
  check_label "$lane"
  need_caller acquire
  self_held_check
  resolve_identity
  slot_out_check
  # D16: the janitor runs here, before the slot loop, so a transient left by a
  # dead process is gone before this invocation makes one of its own.
  janitor_pass
  n=0
  while [ "$n" -lt "$slot_count" ]; do
    slot_path "$n"
    if acquire_one "$sp"; then
      # The slot just won is kept in its own variable: the scan below walks the
      # slot numbers and overwrites the loop's $sp.
      won=$sp
      # F56: the same-worktree scan, the conditional give-back and the busy
      # line all come before anything is printed or recorded (F56b).
      pause_at GATE_LOCK_TEST_PAUSE_BEFORE_SAME_WORKTREE_SCAN
      same_worktree_scan "$won"
      if [ "$sw_found" = 1 ]; then
        # F56b: no `acquired` line and no slot-path file on this answer.
        give_back "$won"
        printf 'gate-lock: busy: %s is held by %s (pid %s, beat %s) in the same worktree %s; sleep and retry, and never remove the lock by hand\n' "$sw_slot" "${sw_owner:-unknown}" "$sw_pid" "$sw_beat" "$wt" >&2
        exit 75
      fi
      printf 'gate-lock: acquired by %s pid %s at %s\n' "$lane" "$caller" "$won"
      if ! write_slot_out "$won"; then
        remove_if_ours "$won" "$lane" "$caller" give-back
        case $? in
        0 | 4) die "the slot path cannot be recorded in GATE_LOCK_SLOT_OUT=$out; the lock was given back" ;;
        1) die "the slot path cannot be recorded in GATE_LOCK_SLOT_OUT=$out; the slot changed hands and was left alone" ;;
        *) die "the slot path cannot be recorded in GATE_LOCK_SLOT_OUT=$out, and the lock was NOT given back: $won still holds it; run 'gate-lock release $lane' (with GATE_LOCK_CALLER_PID=$caller) to remove it" ;;
        esac
      fi
      exit 0
    fi
    n=$((n + 1))
  done
  # F54: every slot is busy.
  printf 'gate-lock: busy: %s is held by %s (pid %s, beat %s); sleep and retry, and never remove the lock by hand\n' "$h_slot" "$h_owner" "$h_pid" "$h_beat" >&2
  exit 75
}

# ---------------------------------------------------------------------------
# heartbeat (C21-C24), verify (C18-C20), release (C13-C17)
# ---------------------------------------------------------------------------

do_heartbeat() {
  need_caller heartbeat
  resolve_pin
  lane=
  find_slot pid
  if [ -z "$target" ]; then
    slot_path 0
    if slot_valid "$sp"; then
      target=$sp
    else
      fail1 "heartbeat: no lock for pid $caller at $sp; nothing to refresh"
    fi
  fi
  if [ ! -e "$target" ]; then
    fail1 "heartbeat: no lock for pid $caller at $target; nothing to refresh"
  fi
  rdf "$target/pid"
  pid_eq "$rd" "$caller" ||
    fail1 "heartbeat refused: $target is held by pid ${rd:-none}, not pid $caller"
  now_s
  hb_stage=$target.beatnew.$$
  rm -f "$hb_stage" 2>/dev/null
  # Staged beside the slot, never under $TMPDIR (F39): a rename across
  # filesystems is copy-then-delete and the beat would be briefly absent.
  if ! (
    set -C
    printf '%s\n' "$now" >"$hb_stage"
  ) 2>/dev/null; then
    rm -f "$hb_stage" 2>/dev/null
    fail1 "heartbeat: cannot write the staged beat $hb_stage"
  fi
  chmod 0600 "$hb_stage" 2>/dev/null
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_BEAT_RENAME
  if [ -d "$target/beat" ] || ! mv -f "$hb_stage" "$target/beat" 2>/dev/null; then
    rm -f "$hb_stage" 2>/dev/null
    fail1 "heartbeat: cannot replace the beat in $target (the lock may be gone)"
  fi
  # The pid was checked before the beat was staged, so a holder that took the
  # name in between had its beat refreshed by this rename. That is harmless (a
  # beat only says "alive", and that holder is no less alive for it), but this
  # caller no longer holds the lock, and must be told so.
  rdf "$target/pid"
  if ! pid_eq "$rd" "$caller"; then
    fail1 "heartbeat: no lock: $target is now held by another holder (pid ${rd:-none}); nothing of this caller's was refreshed"
  fi
  exit 0
}

do_verify() {
  lane=$1
  need_caller verify
  resolve_pin
  find_slot owner
  if [ -z "$target" ]; then
    slot_path 0
    if slot_valid "$sp"; then
      target=$sp
    else
      fail1 "verify: no lock at $sp"
    fi
  fi
  [ -e "$target" ] || fail1 "verify: no lock at $target"
  pause_at GATE_LOCK_TEST_PAUSE_BEFORE_VERIFY_READ
  if [ ! -e "$target" ] && [ ! -h "$target" ]; then
    fail1 "verify: no lock at $target"
  fi
  # The final read is judged on the same terms as a scan: not a symlink, a
  # directory, ours (F57-F59a), whatever the path became since it was found.
  if ! slot_valid "$target"; then
    fail1 "verify failed: $target is not a valid slot any more (a symlink, not a directory, or not ours)"
  fi
  rdf "$target/owner"
  v_found_owner=$rd
  rdf "$target/pid"
  if [ "$v_found_owner" = "$lane" ] && pid_eq "$rd" "$caller"; then
    exit 0
  fi
  fail1 "verify failed: $target is held by ${v_found_owner:-unknown} (pid ${rd:-none}), not $lane (pid $caller)"
}

do_release() {
  lane=$1
  need_caller release
  resolve_pin
  find_slot owner
  if [ -z "$target" ]; then
    # D7: a caller that holds nothing has nothing to release.
    slot_path 0
    printf 'gate-lock: nothing to release (%s)\n' "$sp"
    exit 0
  fi
  if [ ! -e "$target" ]; then
    printf 'gate-lock: nothing to release (%s)\n' "$target"
    exit 0
  fi
  rdf "$target/owner"
  r_owner=$rd
  rdf "$target/pid"
  r_pid=$rd
  if [ "$r_owner" != "$lane" ] || ! pid_eq "$r_pid" "$caller"; then
    fail1 "release refused: $target is held by ${r_owner:-unknown} (pid ${r_pid:-none}), not $lane (pid $caller); it was left alone"
  fi
  remove_if_ours "$target" "$lane" "$caller" release
  case $? in
  0)
    printf 'gate-lock: released by %s (%s)\n' "$lane" "$target"
    exit 0
    ;;
  1) fail1 "release refused: $target changed hands before it could be removed (now held by ${found_owner:-unknown}, pid ${found_pid:-none}); it was left alone" ;;
  4)
    printf 'gate-lock: nothing to release (%s)\n' "$target"
    exit 0
    ;;
  *)
    if [ -d "$target" ]; then
      names_in "$target"
      fail1 "release failed: $target could not be removed; the slot remains and now holds: $names_list"
    fi
    fail1 "release failed: $target could not be removed; it was left aside, never deleted"
    ;;
  esac
}

# ---------------------------------------------------------------------------
# status (C25-C27, D19)
#
# Text: one line per existing slot, or one `free:` line, then a capacity line
# `slots: <live>/<N> live, <stale> stale, pool <path>, format 1`. live counts
# slots whose pid is alive and whose beat is fresh; stale counts the rest; N is
# the configured slot count. Slots beyond N are listed and counted.
#
# JSON (`status --json`, schema version 1), one object:
#   { "version": 1, "format": 1, "pool": <string>, "slotCount": <number>,
#     "live": <number>, "stale": <number>,
#     "slots": [ { "path", "name", "owner", "project", "worktree", "started",
#                  "pid", "beat",
#                  "pidAlive": <bool>,
#                  "beatState": "fresh" | "stale" | "missing" | "future",
#                  "live": <bool> } ] }
# Strings carry the raw file text (first line); bytes outside printable ASCII
# become "?". owner, project, worktree, started, pid and beat are null when the
# file is absent or empty. Slots are listed in slot order.
# ---------------------------------------------------------------------------

# st_line: append the text line for the slot in $sp (state in $s_*).
st_line() {
  if [ "$st_alive" = 1 ]; then
    st_pid="pid $s_pid alive"
  else
    st_pid="pid ${s_pid:-none} not alive"
  fi
  case $beat_state in
  fresh) st_beat="heartbeat fresh (beat $s_beat)" ;;
  future)
    if [ -z "$beat_delta" ]; then
      st_beat="heartbeat fresh (beat $s_beat, in the future)"
    elif [ "$beat_delta" -gt 600 ]; then
      st_beat="heartbeat fresh (beat $s_beat, ${beat_delta}s in the future)"
    else
      st_beat="heartbeat fresh (beat $s_beat)"
    fi
    ;;
  missing) st_beat="heartbeat missing (threshold ${stale_seconds}s)" ;;
  *) st_beat="heartbeat stale (beat $s_beat, threshold ${stale_seconds}s)" ;;
  esac
  st_lines="$st_lines$sp held by ${s_owner:-unknown} project ${s_project:-unknown} started ${s_started:-?} $st_pid, $st_beat
"
}

# st_json_field VALUE: a JSON string, or null when empty.
st_json_field() {
  if [ -z "$1" ]; then
    printf 'null'
  else
    json_str "$1"
  fi
}

# st_json_entry: append the JSON object for the slot in $sp.
st_json_entry() {
  [ -z "$st_entries" ] || st_entries="$st_entries,"
  if [ "$st_alive" = 1 ]; then st_a=true; else st_a=false; fi
  if [ "$st_isl" = 1 ]; then st_l=true; else st_l=false; fi
  st_entries="$st_entries{\"path\":$(json_str "$sp"),\"name\":$(json_str "${sp##*/}"),\"owner\":$(st_json_field "$s_owner"),\"project\":$(st_json_field "$s_project"),\"worktree\":$(st_json_field "$s_worktree"),\"started\":$(st_json_field "$s_started"),\"pid\":$(st_json_field "$s_pid"),\"beat\":$(st_json_field "$s_beat"),\"pidAlive\":$st_a,\"beatState\":\"$beat_state\",\"live\":$st_l}"
}

do_status() {
  st_json=$1
  st_live=0
  st_count=0
  st_entries=
  st_lines=
  n=0
  while [ "$n" -lt 64 ]; do
    slot_path "$n"
    if slot_valid "$sp"; then
      read_slot "$sp"
      now_s
      st_alive=0
      pid_alive "$s_pid" && st_alive=1
      judge_beat "$s_beat"
      st_isl=0
      if [ "$st_alive" = 1 ] && [ "$beat_fresh" = 1 ]; then
        st_isl=1
        st_live=$((st_live + 1))
      fi
      st_count=$((st_count + 1))
      if [ "$st_json" = 1 ]; then
        st_json_entry
      else
        st_line
      fi
    fi
    n=$((n + 1))
  done
  st_stale=$((st_count - st_live))
  if [ "$st_json" = 1 ]; then
    printf '{"version":1,"format":1,"pool":%s,"slotCount":%s,"live":%s,"stale":%s,"slots":[%s]}\n' "$(json_str "$pool")" "$slot_count" "$st_live" "$st_stale" "$st_entries"
  else
    if [ "$st_count" -eq 0 ]; then
      printf 'free: %s is not held\n' "$base"
    else
      printf '%s' "$st_lines"
    fi
    printf 'slots: %s/%s live, %s stale, pool %s, format 1\n' "$st_live" "$slot_count" "$st_stale" "$pool"
  fi
  exit 0
}

# ---------------------------------------------------------------------------
# clean (D16): the janitor as a subcommand of its own, so an operator can run
# the same pass that every acquire runs. Read-only otherwise, and it never
# touches a slot.
# ---------------------------------------------------------------------------

do_clean() {
  janitor_pass
  exit 0
}

# ---------------------------------------------------------------------------
# Dispatch (C2): usage errors come after configuration (C1, D9).
# ---------------------------------------------------------------------------

case ${1:-} in
acquire | release | verify)
  if [ "$#" -ne 2 ] || [ -z "$2" ]; then
    usage_error "$1 needs exactly one argument, the lane"
  fi
  case $1 in
  acquire) do_acquire "$2" ;;
  release) do_release "$2" ;;
  verify) do_verify "$2" ;;
  esac
  ;;
heartbeat)
  [ "$#" -eq 1 ] || usage_error "heartbeat takes no arguments"
  do_heartbeat
  ;;
status)
  case $# in
  1) do_status 0 ;;
  2)
    [ "$2" = --json ] || usage_error "status takes no arguments but --json"
    do_status 1
    ;;
  *) usage_error "status takes no arguments but --json" ;;
  esac
  ;;
clean)
  [ "$#" -eq 1 ] || usage_error "clean takes no arguments"
  do_clean
  ;;
run)
  echo "gate-lock: not implemented yet" >&2
  exit 2
  ;;
'') usage_error "no subcommand" ;;
*) usage_error "unknown subcommand '$1'" ;;
esac
