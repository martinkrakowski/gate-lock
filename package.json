{
  "name": "@hexagen-monaco/gate-lock",
  "version": "0.1.0",
  "description": "A host-wide gate lock: a shared pool of test-runner slots across projects and worktrees on one host.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gate-lock": "bin/gate-lock"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinkrakowski/gate-lock.git"
  },
  "homepage": "https://github.com/martinkrakowski/gate-lock#readme",
  "bugs": {
    "url": "https://github.com/martinkrakowski/gate-lock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && node scripts/shellcheck.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vitest": "^4.1.11"
  }
}
